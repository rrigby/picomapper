{
  "name": "rrigby/picomapper",
  "description": "Minimalist data mapper built on PicoDb",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.0",
    "rrigby/picodb": "^8.1.0"
  },
  "config": {
    "platform": {
      "php": "8.0"
    }
  },
  "autoload": {
    "psr-4": {"PicoMapper\\": "src/"}
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "rector/rector": "^2.6",
    "phpstan/phpstan": "^2.2"
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "vendor/bin/phpstan analyse",
    "rector": "vendor/bin/rector process --dry-run",
    "rector:fix": "vendor/bin/rector process"
  }
}
